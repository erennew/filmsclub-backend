# FilmsClub backend configuration template
# Copy to .env for local runs, or set these as config vars on Heroku/Railway/Render.
# .env is gitignored and dockerignored — never commit real credentials.

# ── Required ────────────────────────────────────────────────────────────
API_ID=your_telegram_api_id
API_HASH=your_telegram_api_hash
BOT_TOKEN=your_bot_token
DATABASE=mongodb+srv://user:pass@cluster.mongodb.net/?appName=yourApp
# Additional clusters (optional). Cluster 1 is the default ops cluster.
# DATABASE_2=
# DATABASE_3=
# DATABASE_4=
# DATABASE_5=
# DATABASE_6=

# ── Admin panel ─────────────────────────────────────────────────────────
ADMIN_WEB_USERNAME=admin
# Min 8 chars; weak values like admin123/password/changeme are rejected.
ADMIN_WEB_PASSWORD=change_me_to_a_long_random_value
# Optional bcrypt hash; takes precedence over ADMIN_WEB_PASSWORD.
# ADMIN_WEB_PASSWORD_HASH=
# Random signing key. If unset, sessions die on every restart.
# Generate: openssl rand -hex 32
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL=86400

# ── Server / URLs ───────────────────────────────────────────────────────
# Heroku injects PORT automatically — do not set it there.
# PORT=8000
# Public URL of the API. Put a Cloudflare-proxied custom domain here, not the
# raw *.herokuapp.com host, so the origin stays hidden.
BASE_URL=https://api.your-domain.example
WEBSITE_URL=https://your-frontend.example
CORS_ORIGINS=https://your-frontend.example,http://localhost:5173

# ── Security hardening ──────────────────────────────────────────────────
# Generate: openssl rand -hex 32
STREAM_TOKEN_SECRET=
# Lifetime of signed /dl tokens, seconds (default 12h, max 7d).
STREAM_TOKEN_TTL=43200
# Set true only while migrating an old frontend that still uses raw file IDs.
ALLOW_LEGACY_STREAM_IDS=false
# When set, every request except /health must carry X-Edge-Key. Configure a
# Cloudflare Transform Rule to inject this header and keep the origin locked.
# EDGE_SHARED_SECRET=
# Trust Cloudflare's CF-Connecting-IP for rate limits/client IP resolution.
# TRUST_CLOUDFLARE=true
# Trust the right-most X-Forwarded-For hop (Heroku router). Default true.
TRUST_PROXY_HEADERS=true
# Optional comma-separated allowlist for /admin and /admin/api/*.
# ADMIN_ALLOWED_IPS=203.0.113.10
# Re-enables /docs, /redoc and /openapi.json for trusted operators only.
ENABLE_API_DOCS=false
MAX_JSON_BODY_BYTES=262144
MAX_ADMIN_BODY_BYTES=4194304
# Stream tokens are bearer credentials; keep access logs off unless debugging.
UVICORN_ACCESS_LOG=false

# ── Telegram access ─────────────────────────────────────────────────────
OWNER_ID=your_telegram_id
ADMIN_IDS=your_telegram_id
AUTH_CHANNEL=-100xxxxxxxxxx,-100xxxxxxxxxx
# Optional bot/user session string (otherwise recreated at boot).
# SESSION_STRING=
# Optional user-account session string. Required for channel indexing:
# Telegram forbids bots from reading channel history (BOT_METHOD_INVALID).
# Generate with: python generate_user_session.py
# USER_SESSION_STRING=
# Enables /is_member for the frontend when set (endpoint is 404 without it).
# INTERNAL_API_KEY=
# TG_USERNAME=
# UPDATE_CHANNEL=

# ── Metadata ────────────────────────────────────────────────────────────
TMDB_API=your_tmdb_api_key
IMDB_API=https://your-imdb-api.example
USE_TMDB=True
USE_CAPTION=True
MULTI_CLIENT=False
# Extra bot accounts that share the per-viewer download load. Add one line per
# bot, numbered consecutively; they are picked up by name, and MULTI_CLIENT is
# enabled automatically once more than one client starts.
# Each bot MUST be an admin of every channel whose files you stream, or viewers
# routed to it fall through to another client instead of playing.
# MULTI_TOKEN1=123456789:your-bot-token
# MULTI_TOKEN2=987654321:your-bot-token
# USE_DEFAULT_ID=  # optional default Telegram file id for /start demos

# ── Queue engine ────────────────────────────────────────────────────────
ENABLE_MONGODB_QUEUE=true
QUEUE_WORKERS=2
QUEUE_TTL_DAYS=2
PROCESSED_TTL_DAYS=3
RESUME_ON_START=true
QUEUE_CLAIM_TIMEOUT=7200
QUEUE_STATE_POLL_SECONDS=5
QUEUE_CHANNEL_REFRESH_SECONDS=30
QUEUE_PRIORITY_LIVE=0
QUEUE_PRIORITY_RESCAN=1
FILE_QUEUE_DELAY=1
VALIDATION_DELAY=1
FILE_VALIDATION_DELAY=1
BATCH_SIZE=50
BATCH_GAP_SECONDS=2
MAX_RETRY_COUNT=3
MAX_MESSAGES_PER_MINUTE=300
RATE_LIMIT_SECONDS=60
ENABLE_PACK_DETECTION=true
MAX_QUALITIES_PER_TITLE=6
FLOODWAIT_MAX_RETRIES=5
FLOODWAIT_BASE_DELAY=30

# ── Streaming cache ─────────────────────────────────────────────────────
ENABLE_VIDEO_CACHE=true
VIDEO_CACHE_HOT_START_SLOTS=100
VIDEO_CACHE_HOT_START_SIZE_MB=1
VIDEO_CACHE_LRU_SIZE_MB=256
VIDEO_CACHE_CHUNK_SIZE=1048576
# File parts kept in flight per viewer (1-8). Each part is fetched with its own
# GetFile call, so this multiplies per-viewer throughput against a distant media
# DC. In-flight memory is roughly this x VIDEO_CACHE_CHUNK_SIZE per stream.
VIDEO_PREFETCH_WINDOW=4
FILE_METADATA_CACHE_SIZE=5000
HOT_MOVIES_CACHE_SIZE=500
TRENDING_CACHE_TTL=160
SEARCH_CACHE_TTL=3000
MEDIA_INFO_CACHE_TTL=864000
MOVIE_DETAIL_CACHE_TTL=30000
TV_DETAIL_CACHE_TTL=30000
BROWSER_CACHE_MAX_AGE=60
CDN_CACHE_TTL=300
CDN_STATIC_TTL=2592000
VIEWS_TTL_DAYS=90

# ── Remux cache (audio/subtitle switching) ──────────────────────────────
REMUX_CACHE_SIZE_MB=256
REMUX_CACHE_TTL_HOURS=24
# REMUX_CACHE_DIR=/app/.cache/remux

# ── Storage hygiene / admin alerts ──────────────────────────────────────
CLUSTER_QUOTA_MB=512
STORAGE_ALERT_PERCENT=70
SHARD_STATS_REFRESH_SECONDS=3600
# Move queue/ops collections to the emptiest cluster when the current one is
# this full (percent). Checked every OPS_CHECK_SECONDS.
OPS_FAILOVER_ENABLED=true
OPS_MOVE_PERCENT=90
OPS_CHECK_SECONDS=300

# ── Media probing ───────────────────────────────────────────────────────
ENABLE_MEDIA_PROBE=true
MEDIA_PROBE_QUICK_STEPS=4
MEDIA_PROBE_DEEP_ON_TIE=true
MAX_PROBE_SIZE_MB=50
PROBE_TIMEOUT=30
ENABLE_TMDB_VALIDATION=true
TMDB_VALIDATION_TIMEOUT=7
TMDB_CACHE_TTL=86400
CACHE_TMDB_IDS=true
SKIP_TMDB_ON_TIMEOUT=false

# ── Full-channel indexing ───────────────────────────────────────────────
INDEX_SCAN_BATCH_SIZE=200
INDEX_SCAN_BATCH_DELAY=2.0
INDEX_MAX_QUEUE_BACKLOG=2000
INDEX_BACKLOG_WAIT_SECONDS=30
INDEX_ENABLE_PROBE=true
INDEX_RESUME_ON_START=true
INDEX_FILE_DELAY=0.5
INDEX_PROGRESS_EDIT_INTERVAL=15
INDEX_MAX_BATCH_FAILURES=5
INDEX_FLOODWAIT_MAX_RETRIES=5
INDEX_STORAGE_CHECK_SECONDS=300
INDEX_STORAGE_STOP_PERCENT=92
# Default answer pre-filled in the "skip newest N messages" prompt shown before
# a full-channel scan. 0 indexes everything; admins can override per scan in
# the bot prompt or the admin console, and the runtime-config knob is live.
INDEX_SKIP_FIRST_MESSAGES=0

# ── Redis (optional) ────────────────────────────────────────────────────
ENABLE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# ── Self-updater ────────────────────────────────────────────────────────
UPSTREAM_REPO=
UPSTREAM_BRANCH=main
