# Required
API_ID=your_telegram_api_id
API_HASH=your_telegram_api_hash
BOT_TOKEN=your_bot_token
DATABASE=mongodb+srv://user:pass@cluster.mongodb.net/dbname

# Server Configuration
PORT=8000
BASE_URL=0.0.0.0
WEBSITE_URL=https://yourdomain.com
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=https://yourdomain.com,http://localhost:5173

# Authentication
AUTH_CHANNEL=channel_id_1,channel_id_2
OWNER_ID=your_telegram_id
ADMIN_IDS=admin_id_1,admin_id_2
ADMIN_WEB_USERNAME=admin
# Use a long random value; never leave the default.
ADMIN_WEB_PASSWORD=change_me_to_a_long_random_value
# Optional: bcrypt hash instead of a plaintext password.
# ADMIN_WEB_PASSWORD_HASH=
# Optional: signing key for admin sessions (random value; regenerated on restart if unset).
# ADMIN_SESSION_SECRET=
# Optional: key required by /is_member for internal callers. Endpoint is disabled when unset.
# INTERNAL_API_KEY=

# TMDB Configuration
TMDB_API=your_tmdb_api_key
IMDB_API=your_imdb_api_key
USE_TMDB=True

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS=true

# Cache Configuration
TRENDING_CACHE_TTL=160
SEARCH_CACHE_TTL=300
MEDIA_INFO_CACHE_TTL=86400
VIDEO_CACHE_LRU_SIZE_MB=500
VIDEO_CACHE_CHUNK_SIZE=1048576
REMUX_CACHE_SIZE_MB=4096
REMUX_CACHE_TTL_HOURS=24

# Telegram
TG_USERNAME=your_bot_username
UPDATE_CHANNEL=your_channel_username

# Full-channel indexing (send a t.me post link to the bot in DM)
# History paging: messages per request and seconds between requests
INDEX_SCAN_BATCH_SIZE=200
INDEX_SCAN_BATCH_DELAY=2.0
# Pause scanning while this many files are already waiting in the queue
INDEX_MAX_QUEUE_BACKLOG=2000
INDEX_BACKLOG_WAIT_SECONDS=30
# Media probe during bulk indexing (richer audio/subtitle data, but slower)
INDEX_ENABLE_PROBE=true
# Automatically continue an interrupted scan after a restart
INDEX_RESUME_ON_START=true

