# FilmsClub backend configuration template
# Copy to .env for local runs, or set these as config vars on Heroku/Railway/Render.
# .env is gitignored and dockerignored — never commit real credentials.

# ── Required ────────────────────────────────────────────────────────────
API_ID=your_telegram_api_id
API_HASH=your_telegram_api_hash
BOT_TOKEN=your_bot_token
DATABASE=mongodb+srv://user:pass@cluster.mongodb.net/?appName=yourApp
# Additional media-only clusters (optional). Cluster 1 is the ops cluster.
# DATABASE_2=
# DATABASE_3=
# DATABASE_4=
# DATABASE_5=

# ── Admin panel ─────────────────────────────────────────────────────────
ADMIN_WEB_USERNAME=admin
# Min 8 chars; weak values like admin123/password/changeme are rejected.
ADMIN_WEB_PASSWORD=change_me_to_a_long_random_value
# Optional bcrypt hash; takes precedence over ADMIN_WEB_PASSWORD.
# ADMIN_WEB_PASSWORD_HASH=
# Random signing key. If unset, sessions die on every restart.
# Generate: openssl rand -hex 32
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL=86400

# ── Server / URLs ───────────────────────────────────────────────────────
# Heroku injects PORT automatically — do not set it there.
# PORT=8000
# Must be the public URL; used to build /dl stream and probe links.
BASE_URL=https://your-app.herokuapp.com
WEBSITE_URL=https://your-frontend.example
CORS_ORIGINS=https://your-frontend.example,http://localhost:5173

# ── Telegram access ─────────────────────────────────────────────────────
OWNER_ID=your_telegram_id
ADMIN_IDS=your_telegram_id
AUTH_CHANNEL=-100xxxxxxxxxx,-100xxxxxxxxxx
# Optional bot/user session string (otherwise recreated at boot).
# SESSION_STRING=
# Enables /is_member for the frontend when set (endpoint is 404 without it).
# INTERNAL_API_KEY=
# TG_USERNAME=
# UPDATE_CHANNEL=

# ── Metadata ────────────────────────────────────────────────────────────
TMDB_API=your_tmdb_api_key
IMDB_API=https://your-imdb-api.example
USE_TMDB=True
USE_CAPTION=True
MULTI_CLIENT=False
# USE_DEFAULT_ID=  # optional default Telegram file id for /start demos

# ── Queue engine ────────────────────────────────────────────────────────
ENABLE_MONGODB_QUEUE=true
QUEUE_WORKERS=2
QUEUE_TTL_DAYS=2
PROCESSED_TTL_DAYS=3
RESUME_ON_START=true
QUEUE_CLAIM_TIMEOUT=7200
QUEUE_STATE_POLL_SECONDS=5
QUEUE_CHANNEL_REFRESH_SECONDS=30
QUEUE_PRIORITY_LIVE=0
QUEUE_PRIORITY_RESCAN=1
FILE_QUEUE_DELAY=1
VALIDATION_DELAY=1
FILE_VALIDATION_DELAY=1
BATCH_SIZE=50
BATCH_GAP_SECONDS=2
MAX_RETRY_COUNT=3
MAX_MESSAGES_PER_MINUTE=300
RATE_LIMIT_SECONDS=60
ENABLE_PACK_DETECTION=true
MAX_QUALITIES_PER_TITLE=6
FLOODWAIT_MAX_RETRIES=5
FLOODWAIT_BASE_DELAY=30

# ── Streaming cache ─────────────────────────────────────────────────────
ENABLE_VIDEO_CACHE=true
VIDEO_CACHE_HOT_START_SLOTS=100
VIDEO_CACHE_HOT_START_SIZE_MB=1
VIDEO_CACHE_LRU_SIZE_MB=256
VIDEO_CACHE_CHUNK_SIZE=1048576
FILE_METADATA_CACHE_SIZE=5000
HOT_MOVIES_CACHE_SIZE=500
TRENDING_CACHE_TTL=160
SEARCH_CACHE_TTL=3000
MEDIA_INFO_CACHE_TTL=864000
MOVIE_DETAIL_CACHE_TTL=30000
TV_DETAIL_CACHE_TTL=30000
BROWSER_CACHE_MAX_AGE=60
CDN_CACHE_TTL=300
CDN_STATIC_TTL=2592000
VIEWS_TTL_DAYS=90

# ── Remux cache (audio/subtitle switching) ──────────────────────────────
REMUX_CACHE_SIZE_MB=256
REMUX_CACHE_TTL_HOURS=24
# REMUX_CACHE_DIR=/app/.cache/remux

# ── Storage hygiene / admin alerts ──────────────────────────────────────
CLUSTER_QUOTA_MB=512
STORAGE_ALERT_PERCENT=70
SHARD_STATS_REFRESH_SECONDS=3600

# ── Media probing ───────────────────────────────────────────────────────
ENABLE_MEDIA_PROBE=true
MEDIA_PROBE_QUICK_STEPS=4
MEDIA_PROBE_DEEP_ON_TIE=true
MAX_PROBE_SIZE_MB=50
PROBE_TIMEOUT=30
ENABLE_TMDB_VALIDATION=true
TMDB_VALIDATION_TIMEOUT=7
TMDB_CACHE_TTL=86400
CACHE_TMDB_IDS=true
SKIP_TMDB_ON_TIMEOUT=false

# ── Full-channel indexing ───────────────────────────────────────────────
INDEX_SCAN_BATCH_SIZE=200
INDEX_SCAN_BATCH_DELAY=2.0
INDEX_MAX_QUEUE_BACKLOG=2000
INDEX_BACKLOG_WAIT_SECONDS=30
INDEX_ENABLE_PROBE=true
INDEX_RESUME_ON_START=true
INDEX_FILE_DELAY=0.5
INDEX_PROGRESS_EDIT_INTERVAL=15
INDEX_MAX_BATCH_FAILURES=5
INDEX_FLOODWAIT_MAX_RETRIES=5
INDEX_STORAGE_CHECK_SECONDS=300
INDEX_STORAGE_STOP_PERCENT=92

# ── Redis (optional) ────────────────────────────────────────────────────
ENABLE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# ── Self-updater ────────────────────────────────────────────────────────
UPSTREAM_REPO=
UPSTREAM_BRANCH=main
