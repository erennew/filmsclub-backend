# ──────────────────────────────────────────────────────────────────────────────
# Frontend environment file (copy this to `.env` and fill in your values)
#
# VITE_BASE_URL  ── REQUIRED in production. Point this at the backend/API origin.
#                    Examples:
#                      local dev : http://localhost:8000
#                      backend on Heroku/Railway/Render : https://your-app.herokuapp.com
#                      Cloudflare-proxied worker : https://api.yourdomain.com
#                    This value is baked into the Vite build at build time, so if
#                    you change it you must rebuild (`npm run build`) for the change
#                    to take effect on Vercel.
#                    The admin console uses the same build output, so a production
#                    console build without VITE_BASE_URL set gets an empty origin and
#                    every `/admin/api/...` request returns the SPA's own index.html.
#                    You can also override the backend URL at runtime via the
#                    console's connection settings after logging in.
#
# Other optional vars: VITE_SITENAME, VITE_TG_URL, VITE_TG_USERNAME,
#   VITE_BOT_USERNAME.
# ──────────────────────────────────────────────────────────────────────────────

VITE_BASE_URL=https://your-backend-url.com
VITE_SITENAME=CloudXMovies
VITE_TG_URL=https://t.me/your_bot
VITE_TG_USERNAME=your_bot_username
VITE_BOT_USERNAME=your_bot_username